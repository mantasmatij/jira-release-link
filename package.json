{
    "name": "jira-release-link",
    "version": "1.0.0",
    "description": "Assigns Jira issues to a release version by version name and ticket list. Gets the last commit message and gathers Jira ticket keys to assign to a project.",
    "main": "dist/assign-tickets.js",
    "scripts": {
        "test": "echo \"Error: no test specified\" && exit 1",
        "build": "ncc build src/assign-tickets.ts -o dist --source-map",
        "type-check": "tsc --noEmit",
        "dev": "tsc --noEmit --watch",
        "format": "biome format --write .",
        "lint": "biome lint .",
        "lint:fix": "biome lint --write .",
        "check": "biome check .",
        "check:fix": "biome check --write .",
        "check:unsafe": "biome check --write --unsafe ."
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/mantasmatij/jira-release-link.git"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "module",
    "bugs": {
        "url": "https://github.com/mantasmatij/jira-release-link/issues"
    },
    "homepage": "https://github.com/mantasmatij/jira-release-link#readme",
    "dependencies": {
        "@actions/core": "^1.11.1",
        "@actions/github": "^6.0.1",
        "axios": "^1.11.0",
        "node": "^20.19.4"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.3.2",
        "@types/node": "^24.1.0",
        "@types/node-fetch": "^2.6.13",
        "@vercel/ncc": "^0.38.3",
        "typescript": "^5.0.0"
    }
}
